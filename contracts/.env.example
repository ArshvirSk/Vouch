# Copy to contracts/.env and fill in. NEVER commit the real .env.
# Generate a FRESH key for Amoy only — never reuse a mainnet key.

# Funded deployer key for Polygon Amoy (testnet). Get test POL from
# https://faucet.polygon.technology/
PRIVATE_KEY=

# Optional RPC override
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Optional: enables automatic source verification after deploy
POLYGONSCAN_API_KEY=
